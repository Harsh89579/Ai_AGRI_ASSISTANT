# Use Python 3.11 slim as base image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY requirements.unified.txt .
RUN pip install --no-cache-dir -r requirements.unified.txt

# Copy the entire services directory (to preserve data/ and other assets)
COPY . .

# Set environment variables
ENV PORT=8000
ENV DB_PATH=/app/chat_orchestrator/data/agri_knowledge.db

# Expose the port
EXPOSE 8000

# Run the unified backend
CMD ["python", "unified_main.py"]
